{
  "name": "equities",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run && node --test scripts/market-source.test.mjs",
    "collect": "node scripts/collect-market.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts e2e *.ts *.json deployment/workflows",
    "publish:manual": "npm run build -- --base /equities/ && node scripts/publish-pages.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "cheerio": "^1.2.0",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.65.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
